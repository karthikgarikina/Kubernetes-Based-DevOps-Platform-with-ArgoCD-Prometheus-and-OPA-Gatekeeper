# Environment Configuration for Kubernetes DevOps Platform

# Cluster Configuration
CLUSTER_NAME=devops-platform
KUBERNETES_VERSION=v1.31.0
KUBECONFIG_PATH=~/.kube/config

# ArgoCD Configuration
ARGOCD_NAMESPACE=argocd
ARGOCD_SERVER_REPLICAS=2
ARGOCD_REPO_SERVER_REPLICAS=2
ARGOCD_ADMIN_PASSWORD=adminpassword123

# Observability Configuration
MONITORING_NAMESPACE=monitoring
LOGGING_NAMESPACE=logging
TRACING_NAMESPACE=tracing

# Security & Governance Configuration
GATEKEEPER_NAMESPACE=gatekeeper-system
VAULT_NAMESPACE=vault
VAULT_DEV_ROOT_TOKEN_ID=root-token-devops-platform
TRIVY_NAMESPACE=trivy-system

# Application Configuration
APP_NAMESPACE=production
APP_IMAGE_TAG=v1.0.0
APP_PORT=3000
